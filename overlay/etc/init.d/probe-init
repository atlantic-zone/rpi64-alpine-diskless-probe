#!/sbin/openrc-run

description="Initialize RPi Alpine probe settings and generate Telegraf configuration"

depend() {
    after localmount modules
    before telegraf
}

CONF_FILE="/media/mmcblk0p1/probe.conf"

start() {
    ebegin "Initializing probe configuration from ${CONF_FILE}"

    # Ensure AF_PACKET kernel socket module is loaded for udhcpc
    modprobe af_packet 2>/dev/null || true

    if [ -f "${CONF_FILE}" ]; then
        . "${CONF_FILE}"

        # 1. Hostname
        if [ -n "${HOSTNAME}" ]; then
            echo "${HOSTNAME}" > /etc/hostname
            hostname "${HOSTNAME}"
        fi

        # 2. Timezone
        TIMEZONE="${TIMEZONE:-Europe/Paris}"
        if [ -f "/usr/share/zoneinfo/${TIMEZONE}" ]; then
            cp "/usr/share/zoneinfo/${TIMEZONE}" /etc/localtime
            echo "${TIMEZONE}" > /etc/timezone
        fi

        # 3. Keyboard Layout
        KEYMAP="${KEYMAP:-us-intl}"
        if [ -n "${KEYMAP}" ]; then
            echo "KEYMAP=${KEYMAP}" > /etc/conf.d/keymaps
        fi

        # 4. Local Root Password for Console / Emergency Login
        if [ -n "${ROOT_PASSWORD}" ]; then
            echo "root:${ROOT_PASSWORD}" | chpasswd 2>/dev/null || true
        fi

        # 5. SSH Keys (Supports multiple space/newline separated URLs)
        mkdir -p /root/.ssh
        chmod 700 /root/.ssh
        if [ -n "${SSH_KEYS_URL}" ]; then
            for url in ${SSH_KEYS_URL}; do
                curl -sSL --max-time 15 "${url}" >> /root/.ssh/authorized_keys 2>/dev/null || true
            done
            sort -u /root/.ssh/authorized_keys -o /root/.ssh/authorized_keys
            chmod 600 /root/.ssh/authorized_keys
        fi

        # 6. Network Configuration (/etc/network/interfaces)
        NET_IFACE="${NET_IFACE:-eth0}"
        cat > /etc/network/interfaces <<EOF
auto lo
iface lo inet loopback
EOF

        if [ -n "${STATIC_IP}" ]; then
            NET_MASK="${NET_MASK:-255.255.255.0}"
            NET_GATEWAY="${NET_GATEWAY:-${STATIC_IP%.*}.1}"
            cat >> /etc/network/interfaces <<EOF

auto ${NET_IFACE}
iface ${NET_IFACE} inet static
    address ${STATIC_IP}
    netmask ${NET_MASK}
    gateway ${NET_GATEWAY}
EOF
        else
            cat >> /etc/network/interfaces <<EOF

auto ${NET_IFACE}
iface ${NET_IFACE} inet dhcp
EOF
        fi

        # 7. Wi-Fi Configuration
        if [ -n "${WIFI_SSID}" ]; then
            mkdir -p /etc/wpa_supplicant
            cat > /etc/wpa_supplicant/wpa_supplicant.conf <<EOF
ctrl_interface=DIR=/var/run/wpa_supplicant GROUP=wheel
update_config=1
country=${WIFI_COUNTRY:-FR}

network={
    ssid="${WIFI_SSID}"
    psk="${WIFI_PASSWORD}"
}
EOF
            chmod 600 /etc/wpa_supplicant/wpa_supplicant.conf

            # Load Wi-Fi kernel drivers if wlan0 is configured
            modprobe cfg80211 2>/dev/null || true
            modprobe brcmfmac 2>/dev/null || true

            cat >> /etc/network/interfaces <<EOF

auto wlan0
iface wlan0 inet dhcp
    wpa-conf /etc/wpa_supplicant/wpa_supplicant.conf
EOF
        fi

        # DNS Server override
        if [ -n "${DNS_SERVERS}" ]; then
            echo "" > /etc/resolv.conf
            for dns in ${DNS_SERVERS}; do
                echo "nameserver ${dns}" >> /etc/resolv.conf
            done
        fi

        # Restart networking to apply interfaces
        rc-service networking restart 2>/dev/null || true

        # 8. Dynamic GPIO Overlay adjustment
        if [ -n "${GPIO_PIN}" ] && [ "${GPIO_PIN}" != "4" ]; then
            sed -i "s/gpiopin=[0-9]*/gpiopin=${GPIO_PIN}/" /media/mmcblk0p1/usercfg.txt 2>/dev/null || true
        fi
    else
        einfo "No probe.conf found on SD card root. Using defaults."
        if [ ! -f /etc/network/interfaces ]; then
            cat > /etc/network/interfaces <<EOF
auto lo
iface lo inet loopback

auto eth0
iface eth0 inet dhcp
EOF
        fi
    fi

    # --------------------------------------------------------------------------
    # 9. OPENSSH SERVER
    # --------------------------------------------------------------------------
    rc-service sshd restart 2>/dev/null || rc-service sshd start 2>/dev/null || true

    # --------------------------------------------------------------------------
    # 10. GENERATE INDUSTRIAL TELEGRAF CONFIGURATION (/etc/telegraf/telegraf.conf)
    # --------------------------------------------------------------------------
    mkdir -p /etc/telegraf
    HOSTNAME_VAL="${HOSTNAME:-rpi-probe-01}"
    LOCATION_VAL="${LOCATION:-datacenter}"
    INTERVAL_VAL="${INTERVAL_SECONDS:-10}s"

    cat > /etc/telegraf/telegraf.conf <<EOF
[global_tags]
  hostname = "${HOSTNAME_VAL}"
  location = "${LOCATION_VAL}"
  probe_type = "rpi64-alpine-diskless"

[agent]
  interval = "${INTERVAL_VAL}"
  round_interval = true
  metric_batch_size = 1000
  metric_buffer_limit = 10000
  collection_jitter = "0s"
  flush_interval = "10s"
  flush_jitter = "0s"
  precision = ""
  hostname = "${HOSTNAME_VAL}"
  omit_hostname = false

# ------------------------------------------------------------------------------
# INPUT PLUGINS (HARDWARE & SYSTEM METRICS)
# ------------------------------------------------------------------------------

# DS18B20 1-Wire Thermal Sensor & Raspberry Pi SoC Temperature
[[inputs.temp]]

# Host System Metrics
[[inputs.system]]

[[inputs.cpu]]
  percpu = false
  totalcpu = true

[[inputs.mem]]

[[inputs.disk]]
  mount_points = ["/media/mmcblk0p1", "/"]

[[inputs.net]]
  interfaces = ["eth0", "wlan0"]

# ------------------------------------------------------------------------------
# OUTPUT PLUGINS (DUAL-MODE METRICS)
# ------------------------------------------------------------------------------

EOF

    # Output 1: Prometheus PULL Exporter (Port 9100)
    ENABLE_PULL_SERVER="${ENABLE_PULL_SERVER:-true}"
    if [ "${ENABLE_PULL_SERVER}" = "true" ]; then
        cat >> /etc/telegraf/telegraf.conf <<EOF
[[outputs.prometheus_client]]
  listen = ":9100"
  path = "/metrics"
EOF
    fi

    # Output 2: VictoriaMetrics / Prometheus Remote Write PUSH
    if [ -n "${VICTORIAMETRICS_URL}" ]; then
        cat >> /etc/telegraf/telegraf.conf <<EOF

[[outputs.http]]
  url = "${VICTORIAMETRICS_URL}"
  data_format = "prometheus"
EOF
    fi

    # Output 3: InfluxDB v2 / v1 Line Protocol PUSH
    if [ -n "${INFLUXDB_URL}" ]; then
        cat >> /etc/telegraf/telegraf.conf <<EOF

[[outputs.influxdb_v2]]
  urls = ["${INFLUXDB_URL}"]
  token = "${INFLUXDB_TOKEN}"
  organization = "${INFLUXDB_ORG}"
  bucket = "${INFLUXDB_BUCKET}"
EOF
    fi

    # Restart Telegraf daemon with updated configuration
    rc-service telegraf restart 2>/dev/null || rc-service telegraf start 2>/dev/null || true

    eend 0
}
