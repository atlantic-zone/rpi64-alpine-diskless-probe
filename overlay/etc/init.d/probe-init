#!/sbin/openrc-run

description="Initialize RPi Alpine probe settings, configure node_exporter, display IP on TTY console /etc/issue"

depend() {
    after localmount modules networking
    before node-exporter
}

CONF_FILE="/media/mmcblk0p1/probe.conf"

start() {
    ebegin "Initializing RPi Probe Settings"

    # Default fallback values if probe.conf is missing or incomplete
    HOSTNAME="rpi-probe"
    LOCATION="unspecified"
    GPIO_PIN="4"
    TIMEZONE="Europe/Paris"
    KEYMAP="us"
    WIFI_COUNTRY="FR"

    # 1. Read SD Card probe.conf if present
    if [ -f "${CONF_FILE}" ]; then
        einfo "Loading configuration from ${CONF_FILE}"
        . "${CONF_FILE}"
    else
        ewarn "No probe.conf found at ${CONF_FILE}. Applying minimal default configuration (DHCP)."
    fi

    # 2. Set Hostname
    echo "${HOSTNAME}" > /etc/hostname
    hostname "${HOSTNAME}" 2>/dev/null || true

    # 3. Timezone
    if [ -f "/usr/share/zoneinfo/${TIMEZONE}" ]; then
        cp "/usr/share/zoneinfo/${TIMEZONE}" /etc/localtime
        echo "${TIMEZONE}" > /etc/timezone
    fi

    # 4. Keyboard Layout
    # Alpine layout: /usr/share/bkeymaps/<pays>/<variante>.bmap.gz  (gzip)
    # KEYMAP=us  -> us/us.bmap.gz     KEYMAP=us-intl -> us/us-intl.bmap.gz
    if [ -n "${KEYMAP}" ]; then
        echo "KEYMAP=${KEYMAP}" > /etc/conf.d/keymaps
        KM_CC="${KEYMAP%%-*}"
        KM_FILE="/usr/share/bkeymaps/${KM_CC}/${KEYMAP}.bmap.gz"
        if command -v loadkmap >/dev/null 2>&1 && [ -f "${KM_FILE}" ]; then
            zcat "${KM_FILE}" | loadkmap 2>/dev/null || true
        else
            ewarn "Keymap ${KEYMAP} not found (${KM_FILE}), falling back to US layout"
        fi
    fi

    # 5. Root Password for Local HDMI Console Emergency Access
    if [ -n "${ROOT_PASSWORD}" ]; then
        echo "root:${ROOT_PASSWORD}" | chpasswd 2>/dev/null || true
        einfo "Root console password applied from probe.conf"
    fi

    # 6. SSH Authorized Keys (Multi-URL supported, default: ts-sz.keys)
    #    sshd StrictModes reads the whole chain and accepts a key only when
    #    /root, /root/.ssh and authorized_keys are owned by root with 700/600.
    #    Enforcing it here repairs a card written from an older image too.
    SSH_KEYS_URL="${SSH_KEYS_URL:-https://github.com/ts-sz.keys}"
    mkdir -p /root/.ssh
    if [ -n "${SSH_KEYS_URL}" ]; then
        for url in ${SSH_KEYS_URL}; do
            curl -sSL --max-time 15 "${url}" >> /root/.ssh/authorized_keys 2>/dev/null || true
        done
        sort -u /root/.ssh/authorized_keys -o /root/.ssh/authorized_keys 2>/dev/null || true
    fi
    chown -R root:root /root
    chmod 700 /root/.ssh
    [ -f /root/.ssh/authorized_keys ] && chmod 600 /root/.ssh/authorized_keys
    einfo "SSH keys: $(grep -c . /root/.ssh/authorized_keys 2>/dev/null || echo 0) authorized"

    # 7. Network Setup (Default: DHCP on eth0/wlan0)
    if [ -n "${STATIC_IP}" ]; then
        NET_IFACE="${NET_IFACE:-eth0}"
        NET_MASK="${NET_MASK:-255.255.255.0}"
        NET_GATEWAY="${NET_GATEWAY:-${STATIC_IP%.*}.1}"

        cat > /etc/network/interfaces <<EOF
auto lo
iface lo inet loopback

auto ${NET_IFACE}
iface ${NET_IFACE} inet static
    address ${STATIC_IP}
    netmask ${NET_MASK}
    gateway ${NET_GATEWAY}
EOF
        if [ -n "${DNS_SERVERS}" ]; then
            echo "" > /etc/resolv.conf
            for dns in ${DNS_SERVERS}; do
                echo "nameserver ${dns}" >> /etc/resolv.conf
            done
        fi
        rc-service networking restart 2>/dev/null || true
    else
        # Fallback: DHCP. wlan0 is only declared when Wi-Fi is actually
        # configured, otherwise udhcpc retries on a dead interface and
        # stalls the boot for ~20s before giving up.
        cat > /etc/network/interfaces <<EOF
auto lo
iface lo inet loopback

auto eth0
iface eth0 inet dhcp
EOF
        if [ -n "${WIFI_SSID}" ]; then
            cat >> /etc/network/interfaces <<EOF

auto wlan0
iface wlan0 inet dhcp
EOF
        fi
    fi

    # Only restart networking when the running config no longer matches what
    # we just wrote. The boot runlevel already brought eth0 up and obtained a
    # DHCP lease; an unconditional restart tears down that working lease.
    if [ -n "${STATIC_IP}" ]; then
        rc-service networking restart 2>/dev/null || ifup -a 2>/dev/null || true
    else
        ifup -a 2>/dev/null || true
    fi

    # 8. Wi-Fi Config
    if [ -n "${WIFI_SSID}" ]; then
        mkdir -p /etc/wpa_supplicant
        cat > /etc/wpa_supplicant/wpa_supplicant.conf <<EOF
ctrl_interface=DIR=/var/run/wpa_supplicant GROUP=wheel
update_config=1
country=${WIFI_COUNTRY}

network={
    ssid="${WIFI_SSID}"
    psk="${WIFI_PASSWORD}"
}
EOF
        chmod 600 /etc/wpa_supplicant/wpa_supplicant.conf
    fi

    # 9. Dynamic GPIO Overlay Adjustment
    if [ -n "${GPIO_PIN}" ] && [ "${GPIO_PIN}" != "4" ]; then
        sed -i "s/gpiopin=[0-9]*/gpiopin=${GPIO_PIN}/" /media/mmcblk0p1/usercfg.txt 2>/dev/null || true
    fi

    # 10. Prometheus node_exporter: launch options and authentication.
    #     Both scripts run exactly once, here, before the service starts.
    #     No cron.
    mkdir -p /var/lib/node_exporter
    chown prometheus:prometheus /var/lib/node_exporter 2>/dev/null || true

    if [ -x /usr/local/bin/probe-exporter-auth ]; then
        /usr/local/bin/probe-exporter-auth || ewarn "probe-exporter-auth failed"
    fi

    if [ -x /usr/local/bin/probe-inventory ]; then
        /usr/local/bin/probe-inventory || ewarn "probe-inventory failed"
    fi

    # 11. Synchronize Time via NTP and Generate /etc/issue Banner
    if command -v chronyd >/dev/null 2>&1; then
        chronyd -q 'server pool.ntp.org iburst' 2>/dev/null || true
    fi

    PRIMARY_IP=""
    for i in $(seq 1 15); do
        # BusyBox grep has no -P (PCRE): use ip -o + awk, both POSIX.
        for IFACE in eth0 wlan0; do
            PRIMARY_IP=$(ip -o -4 addr show "${IFACE}" 2>/dev/null \
                | awk '{split($4,a,"/"); print a[1]; exit}')
            [ -n "${PRIMARY_IP}" ] && break
        done
        [ -n "${PRIMARY_IP}" ] && break
        sleep 1
    done

    if [ -n "${PRIMARY_IP}" ]; then
        IP_LINE="${PRIMARY_IP}"
        METRICS_LINE="http://${PRIMARY_IP}:9100/metrics"
        SSH_LINE="ssh -p 34522 root@${PRIMARY_IP}"
    else
        IP_LINE="no address (check the network cable / DHCP)"
        METRICS_LINE="unavailable until the probe gets an IP"
        SSH_LINE="unavailable until the probe gets an IP"
    fi

    cat > /etc/issue <<EOF

================================================================================
  ATLANTIC ZONE - RPI64 DISKLESS PROBE
================================================================================
  Hostname     : ${HOSTNAME}
  IP Address   : ${IP_LINE}
  Metrics PULL : ${METRICS_LINE}
  SSH Access   : ${SSH_LINE}
================================================================================

EOF

    eend 0
}
