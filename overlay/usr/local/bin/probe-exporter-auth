#!/bin/sh
# probe-exporter-auth - runs EXACTLY ONCE at boot, called by probe-init
#
# Writes /etc/conf.d/node-exporter.
#
#   EXPORTER_PASSWORD_HASH unset -> exporter open, no --web.config.file
#   EXPORTER_PASSWORD_HASH set   -> basic auth, --web.config.file enabled
#
# The bcrypt hash is generated BY THE ADMIN on their own machine, not by the
# probe. No plaintext password ever touches the SD card or the Pi's RAM.
# See probe.conf.example for the generation command.

CONF="/media/mmcblk0p1/probe.conf"
WEB="/etc/node_exporter/web.yml"
OUT="/etc/conf.d/node-exporter"

[ -f "$CONF" ] && . "$CONF" 2>/dev/null

BASE="--web.listen-address=:9100 \
--collector.textfile.directory=/var/lib/node_exporter \
--no-collector.btrfs --no-collector.xfs --no-collector.nvme \
--no-collector.bcache --no-collector.infiniband --no-collector.zfs \
--no-collector.nfs --no-collector.nfsd --no-collector.mdadm \
--no-collector.selinux --no-collector.tapestats --no-collector.fibrechannel"

USER_NAME="${EXPORTER_USER:-probe}"

# A bcrypt hash starts with $2a$ / $2b$ / $2y$ and is 60 characters long.
# Anything else is rejected: a plaintext password pasted here by mistake must
# not produce silently inoperative authentication.
case "$EXPORTER_PASSWORD_HASH" in
    '$2a$'*|'$2b$'*|'$2y$'*)
        mkdir -p /etc/node_exporter
        TMP="${WEB}.$$"
        printf 'basic_auth_users:\n  %s: %s\n' "$USER_NAME" "$EXPORTER_PASSWORD_HASH" > "$TMP"
        chmod 600 "$TMP"
        chown prometheus:prometheus "$TMP" 2>/dev/null
        mv "$TMP" "$WEB"
        ARGS="$BASE --web.config.file=$WEB"
        ;;
    '')
        rm -f "$WEB"
        ARGS="$BASE"
        ;;
    *)
        # Value present but not a bcrypt hash: refuse it and log the reason
        rm -f "$WEB"
        ARGS="$BASE"
        echo "probe-exporter-auth: invalid EXPORTER_PASSWORD_HASH (bcrypt expected), exporter left open" >&2
        ;;
esac

printf 'ARGS="%s"\n' "$ARGS" > "$OUT"
chmod 644 "$OUT"
