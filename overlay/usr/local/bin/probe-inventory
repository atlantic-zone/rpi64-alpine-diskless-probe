#!/bin/sh
# probe-inventory - runs EXACTLY ONCE at boot, called by probe-init
#
# Publishes the only piece of information the machine cannot work out by
# itself: who owns it and where it is installed.
#
# Everything else is already native in node_exporter:
#   sensor temperature -> node_hwmon_temp_celsius{chip="w1_bus_master1_..."}
#   hostname / kernel  -> node_uname_info
#   uptime, cpu, ram   -> standard collectors
#
# Join on the Prometheus side (the instance label is added by the scrape):
#   node_hwmon_temp_celsius{chip=~"w1_bus_master.*"}
#     * on(instance) group_left(client,site,location) probe_info

OUT="/var/lib/node_exporter/probe_inventory.prom"
TMP="${OUT}.$$"
CONF="/media/mmcblk0p1/probe.conf"

[ -f "$CONF" ] && . "$CONF" 2>/dev/null

{
  echo "# HELP probe_info Probe ownership and physical location labels"
  echo "# TYPE probe_info gauge"
  printf 'probe_info{client="%s",site="%s",location="%s"} 1\n' \
    "${CLIENT:-unset}" "${SITE:-unset}" "${LOCATION:-unset}"
} > "$TMP"

chmod 644 "$TMP"
mv "$TMP" "$OUT"
