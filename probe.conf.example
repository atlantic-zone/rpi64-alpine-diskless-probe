# RPi64 Alpine Diskless Probe - Configuration
#
# Copy this file as 'probe.conf' to the root of the SD card (FAT32).
# The card can be read and edited on Windows, macOS and Linux with any plain
# text editor (Notepad is fine).
#
# EVERYTHING IS OPTIONAL. With no probe.conf at all the probe still boots:
# DHCP on eth0, US keymap, Paris time, metrics open on port 9100.

# ------------------------------------------------------------------------------
# 1. IDENTIFICATION
# ------------------------------------------------------------------------------
# Network name of the probe.
HOSTNAME=rpi-probe-01

# Labels published in the probe_info metric.
# They are used to filter and group in Grafana: by client, by site, by physical
# location. Leave them empty if you do not use them.
CLIENT=
SITE=
LOCATION=

# ------------------------------------------------------------------------------
# 2. TIME AND KEYBOARD
# ------------------------------------------------------------------------------
TIMEZONE=Europe/Paris
KEYMAP=us

# ------------------------------------------------------------------------------
# 3. METRICS - PORT 9100
# ------------------------------------------------------------------------------
# By default the exporter is OPEN: http://<IP>:9100/metrics answers anyone on
# the network. That is the intended behaviour on a closed management VLAN.
#
# To protect it with a password, set EXPORTER_PASSWORD_HASH below.
#
#   >>> This file holds a bcrypt hash, and only a hash. <<<
#
# The SD card is not encrypted: anyone can pull it out of the Raspberry Pi and
# read it on a laptop. A bcrypt hash cannot be turned back into the password,
# which is what makes it safe to store here.
#
# STEP 1 - generate the hash ON YOUR OWN MACHINE (not on the probe)
#
#   Linux (Debian, Ubuntu):
#     sudo apt install apache2-utils
#     htpasswd -nbBC 10 probe 'YourPassword' | cut -d: -f2
#
#   Linux (Fedora, RHEL):
#     sudo dnf install httpd-tools
#     htpasswd -nbBC 10 probe 'YourPassword' | cut -d: -f2
#
#   Linux (Arch):
#     sudo pacman -S apache
#     htpasswd -nbBC 10 probe 'YourPassword' | cut -d: -f2
#
#   macOS (htpasswd is already installed):
#     htpasswd -nbBC 10 probe 'YourPassword' | cut -d: -f2
#
#   Without installing anything, using Docker:
#     docker run --rm httpd:alpine htpasswd -nbBC 10 probe 'YourPassword' | cut -d: -f2
#
#   Windows: use Docker Desktop, or WSL with the Ubuntu command above.
#
# The command prints a 60-character line starting with $2y$10$ :
#
#     $2y$10$N9qo8uLOickgx2ZMRZoMyeIjZAgcfl7p92ldGxad68LJZdL17lhWy
#
# STEP 2 - copy it below, BETWEEN SINGLE QUOTES
#
#   EXPORTER_PASSWORD_HASH='$2y$10$N9qo8...'
#
#   Single quotes are what preserves the value: the hash contains '$'
#   characters, which the shell expands inside double quotes or bare, leaving a
#   truncated string that the probe rejects, so the exporter stays open.
#
#EXPORTER_PASSWORD_HASH='$2y$10$N9qo8uLOickgx2ZMRZoMyeIjZAgcfl7p92ldGxad68LJZdL17lhWy'

# Matching username. Must be the one passed to htpasswd.
# Default: probe
#EXPORTER_USER=probe

# On the Prometheus side, declare the target like this:
#
#   - job_name: rpi-probes
#     basic_auth:
#       username: probe
#       password: YourPassword
#     static_configs:
#       - targets: ['10.0.0.150:9100']
#
# To remove the protection: comment out the EXPORTER_PASSWORD_HASH line and
# reboot. The probe deletes its authentication file on the next boot.

# ------------------------------------------------------------------------------
# 4. SSH ACCESS
# ------------------------------------------------------------------------------
# The SSH server listens on port 34522, not 22.
#
#     ssh -p 34522 root@<IP>
#
# Authentication is by key only. Passwords are refused.
# Public keys are downloaded at every boot from the URLs below (several URLs
# allowed, separated by spaces).
SSH_KEYS_URL="https://github.com/ts-sz.keys"

# Root password for the local console (HDMI screen + keyboard) only.
# With no network, this is the only way back in.
#ROOT_PASSWORD=

# ------------------------------------------------------------------------------
# 5. NETWORK - DHCP on eth0 by default
# ------------------------------------------------------------------------------
# For a fixed address, uncomment the following lines.
#STATIC_IP=10.0.0.150
#NET_MASK=255.255.255.0
#NET_GATEWAY=10.0.0.1
#DNS_SERVERS="1.1.1.1 8.8.8.8"

# Interface carrying the static address. Default: eth0
#NET_IFACE=eth0

# Wi-Fi, if there is no network cable.
# Note: wlan0 is only configured when WIFI_SSID is set. On a wired probe an
# unconfigured wlan0 would stall the boot for about 20 seconds.
#WIFI_SSID=
#WIFI_PASSWORD=
#WIFI_COUNTRY=FR

# ------------------------------------------------------------------------------
# 6. DS18B20 TEMPERATURE SENSORS
# ------------------------------------------------------------------------------
# No configuration needed. Sensors wired to GPIO 4 are detected at boot and
# published automatically in the metrics.
GPIO_PIN=4
