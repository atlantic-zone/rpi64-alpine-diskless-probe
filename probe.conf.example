# RPi64 Alpine Diskless Probe Configuration
# Place this file as 'probe.conf' on the root of your FAT32 SD card.

# ------------------------------------------------------------------------------
# 1. IDENTIFICATION & METRICS
# ------------------------------------------------------------------------------
HOSTNAME=rpi-probe-01
LOCATION=datacenter-rack-a1
INTERVAL_SECONDS=10
GPIO_PIN=4

# ------------------------------------------------------------------------------
# 2. PROMETHEUS PULL EXPORTER (Port 9100)
# ------------------------------------------------------------------------------
# Serves http://<IP>:9100/metrics using zero-RAM Busybox httpd.
ENABLE_PULL_SERVER=true

# ------------------------------------------------------------------------------
# 3. PUSH METRICS ENDPOINTS (Optional)
# ------------------------------------------------------------------------------
# VictoriaMetrics / Prometheus HTTP POST Ingestion
#VICTORIAMETRICS_URL=http://metrics.example.com:8428/api/v1/import/prometheus

# InfluxDB v2 / v1 Line Protocol Ingestion
#INFLUXDB_URL=http://influx.example.com:8086/api/v2/write
#INFLUXDB_TOKEN=my-token
#INFLUXDB_ORG=my-org
#INFLUXDB_BUCKET=metrics

# ------------------------------------------------------------------------------
# 4. REGIONAL & KEYBOARD SETTINGS
# ------------------------------------------------------------------------------
TIMEZONE=Europe/Paris
KEYMAP=us-intl

# ------------------------------------------------------------------------------
# 5. SSH ACCESS & SSHX REVERSE WEB TERMINAL ASSISTANCE
# ------------------------------------------------------------------------------
# Multi-URL supported for authorized_keys, separated by spaces
SSH_KEYS_URL="https://github.com/example-team.keys"

# Enable remote web terminal assistance over reverse WebSocket via sshx.io (Optional)
# ENABLE_SSHX=true

# ------------------------------------------------------------------------------
# 6. NETWORK CONFIGURATION (Default: DHCP on eth0)
# ------------------------------------------------------------------------------
# Static IP settings (leave commented out for DHCP)
#STATIC_IP=10.0.0.150
#NET_MASK=255.255.255.0
#NET_GATEWAY=10.0.0.1
#DNS_SERVERS="1.1.1.1 8.8.8.8"

# Optional Wi-Fi settings (leave commented out if using Ethernet RJ45)
#WIFI_SSID=MyWiFiNetwork
#WIFI_PASSWORD=SecretPassword123
#WIFI_COUNTRY=FR
