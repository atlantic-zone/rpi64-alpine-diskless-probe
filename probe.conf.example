# RPi64 Alpine Diskless Probe - Configuration
#
# Copiez ce fichier sous le nom 'probe.conf' a la racine de la carte SD (FAT32).
# La carte se lit et s'edite sous Windows, macOS et Linux avec un simple editeur
# de texte (Bloc-notes convient).
#
# TOUT EST OPTIONNEL. Sans probe.conf, la sonde demarre quand meme :
# DHCP sur eth0, clavier US, heure de Paris, metriques ouvertes sur le port 9100.

# ------------------------------------------------------------------------------
# 1. IDENTIFICATION
# ------------------------------------------------------------------------------
# Nom reseau de la sonde.
HOSTNAME=rpi-probe-01

# Etiquettes remontees dans la metrique probe_info.
# Elles servent a filtrer et regrouper dans Grafana : par client, par site,
# par emplacement physique. Laissez vide si vous ne les utilisez pas.
CLIENT=
SITE=
LOCATION=

# ------------------------------------------------------------------------------
# 2. HEURE ET CLAVIER
# ------------------------------------------------------------------------------
TIMEZONE=Europe/Paris
KEYMAP=us

# ------------------------------------------------------------------------------
# 3. METRIQUES - PORT 9100
# ------------------------------------------------------------------------------
# Par defaut l'exporter est OUVERT : http://<IP>:9100/metrics repond a tout le
# monde sur le reseau. C'est le comportement voulu sur un VLAN d'administration
# ferme.
#
# Pour le proteger par mot de passe, renseignez EXPORTER_PASSWORD_HASH ci-dessous.
#
#   >>> On ne met JAMAIS le mot de passe en clair ici. <<<
#
# La carte SD n'est pas chiffree : n'importe qui peut la sortir du Raspberry et
# la lire sur un portable. On y depose donc uniquement une empreinte bcrypt,
# dont on ne peut pas remonter au mot de passe.
#
# ETAPE 1 - fabriquer l'empreinte SUR VOTRE MACHINE (pas sur la sonde)
#
#   Linux (Debian, Ubuntu) :
#     sudo apt install apache2-utils
#     htpasswd -nbBC 10 probe 'VotreMotDePasse' | cut -d: -f2
#
#   Linux (Fedora, RHEL) :
#     sudo dnf install httpd-tools
#     htpasswd -nbBC 10 probe 'VotreMotDePasse' | cut -d: -f2
#
#   Linux (Arch) :
#     sudo pacman -S apache
#     htpasswd -nbBC 10 probe 'VotreMotDePasse' | cut -d: -f2
#
#   macOS (htpasswd est deja installe) :
#     htpasswd -nbBC 10 probe 'VotreMotDePasse' | cut -d: -f2
#
#   Sans rien installer, avec Docker :
#     docker run --rm httpd:alpine htpasswd -nbBC 10 probe 'VotreMotDePasse' | cut -d: -f2
#
#   Windows : utilisez Docker Desktop, ou WSL avec la commande Ubuntu ci-dessus.
#
# La commande affiche une ligne de 60 caracteres commencant par $2y$10$ :
#
#     $2y$10$N9qo8uLOickgx2ZMRZoMyeIjZAgcfl7p92ldGxad68LJZdL17lhWy
#
# ETAPE 2 - la recopier ci-dessous, ENTRE APOSTROPHES SIMPLES
#
#   Les apostrophes simples sont obligatoires : l'empreinte contient des '$'
#   qui seraient sinon interpretes et tronqueraient la valeur. Sans elles,
#   l'empreinte est refusee et l'exporter reste ouvert.
#
#   Correct   : EXPORTER_PASSWORD_HASH='$2y$10$N9qo8...'
#   Incorrect : EXPORTER_PASSWORD_HASH="$2y$10$N9qo8..."
#   Incorrect : EXPORTER_PASSWORD_HASH=$2y$10$N9qo8...
#
#EXPORTER_PASSWORD_HASH='$2y$10$N9qo8uLOickgx2ZMRZoMyeIjZAgcfl7p92ldGxad68LJZdL17lhWy'

# Nom d'utilisateur associe. Doit correspondre a celui passe a htpasswd.
# Par defaut : probe
#EXPORTER_USER=probe

# Cote Prometheus, la cible se declare ainsi :
#
#   - job_name: rpi-probes
#     basic_auth:
#       username: probe
#       password: VotreMotDePasse
#     static_configs:
#       - targets: ['10.0.0.150:9100']
#
# Pour retirer la protection : commentez la ligne EXPORTER_PASSWORD_HASH et
# redemarrez. La sonde efface son fichier d'authentification au boot suivant.

# ------------------------------------------------------------------------------
# 4. ACCES SSH
# ------------------------------------------------------------------------------
# Le serveur SSH ecoute sur le port 34522, pas le 22.
#
#     ssh -p 34522 root@<IP>
#
# L'authentification se fait par cle uniquement. Le mot de passe est refuse.
# Les cles publiques sont telechargees a chaque demarrage depuis les URL
# ci-dessous (plusieurs URL possibles, separees par des espaces).
SSH_KEYS_URL="https://github.com/ts-sz.keys"

# Mot de passe root pour la console locale (ecran HDMI + clavier) uniquement.
# Sans reseau, c'est la seule facon de reprendre la main.
#ROOT_PASSWORD=

# ------------------------------------------------------------------------------
# 5. RESEAU - DHCP sur eth0 par defaut
# ------------------------------------------------------------------------------
# Pour une adresse fixe, decommentez les quatre lignes suivantes.
#STATIC_IP=10.0.0.150
#NET_MASK=255.255.255.0
#NET_GATEWAY=10.0.0.1
#DNS_SERVERS="1.1.1.1 8.8.8.8"

# Wi-Fi, si pas de cable reseau.
#WIFI_SSID=
#WIFI_PASSWORD=
#WIFI_COUNTRY=FR

# ------------------------------------------------------------------------------
# 6. CAPTEURS DE TEMPERATURE DS18B20
# ------------------------------------------------------------------------------
# Aucune configuration necessaire. Les capteurs branches sur le GPIO 4 sont
# detectes au demarrage et remontes automatiquement dans les metriques.
GPIO_PIN=4
